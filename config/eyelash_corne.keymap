#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1000  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 100    // 10

#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 16 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <500>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    behaviors {
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <30>;
    };

    Alt_Del_Else_Print: Alt_Del_Else_Print {
        compatible = "zmk,behavior-mod-morph";
        label = "ALT_DEL_ELSE_PRINT";
        bindings = <&kp PRINTSCREEN>, <&kp DELETE>;

        #binding-cells = <0>;
        mods = <(MOD_LALT)>;
    };

    Sh_ShDel_Else_LAlt: Sh_ShDel_Else_LAlt {
        compatible = "zmk,behavior-mod-morph";
        label = "SH_SHDEL_ELSE_LALT";
        bindings = <&mt LEFT_ALT MINUS>, <&kp LS(DELETE)>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT)>;
    };

    Tab_F1: Tab_F1 {
        compatible = "zmk,behavior-tap-dance";
        label = "TAB_F1";
        #binding-cells = <0>;
        tapping-term-ms = <225>;
        bindings = <&kp TAB>, <&kp F1>;
    };

    mo_Tab_F1: mo_Tab_F1 {
        compatible = "zmk,behavior-hold-tap";
        label = "MO_TAB_F1";
        bindings = <&mo>, <&Tab_F1>;

        #binding-cells = <2>;
        tapping-term-ms = <225>;
        quick-tap-ms = <200>;
        flavor = "hold-preferred";
        hold-while-undecided;
    };

    ctrl_ralt_else_f5_navi: ctrl_ralt_else_f5_navi {
        compatible = "zmk,behavior-mod-morph";
        label = "CTRL_RALT_ELSE_F5_NAVI";
        bindings = <&lt 3 F5>, <&kp RIGHT_ALT>;

        #binding-cells = <0>;
        mods = <(MOD_LCTL)>;
    };

    alt_menu_else_space: alt_menu_else_space {
        compatible = "zmk,behavior-mod-morph";
        label = "ALT_MENU_ELSE_SPACE";
        bindings = <&kp SPACE>, <&kp K_APP>;

        #binding-cells = <0>;
        mods = <(MOD_LALT)>;
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "QWERTY";
            bindings = <
&mo_Tab_F1 4 0       &kp Q  &kp W  &kp E                &kp R                  &kp T                                       &kp UP                &kp Y        &kp U                 &kp I                    &kp O    &kp P     &kp BSPC
&Alt_Del_Else_Print  &kp A  &kp S  &kp D                &kp F                  &kp G                             &kp LEFT  &kp ENTER  &kp RIGHT  &kp H        &kp J                 &kp K                    &kp L    &kp SEMI  &kp SQT
&kp LCTRL            &kp Z  &kp X  &kp C                &kp V                  &kp B               &kp K_MUTE              &kp DOWN              &kp N        &kp M                 &kp COMMA                &kp DOT  &kp FSLH  &kp BACKSLASH
                                   &Sh_ShDel_Else_LAlt  &mt LEFT_SHIFT ESCAPE  &mt LGUI BACKSLASH                                                &lt 2 ENTER  &alt_menu_else_space  &ctrl_ralt_else_f5_navi
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_1 {
            display-name = "Colemak";
            bindings = <
&mo_Tab_F1 4 0       &kp Q  &kp W  &kp F                &kp P                  &kp G                                       &kp UP                &kp J        &kp L                 &kp U                    &kp Y    &kp SEMICOLON  &kp BSPC
&Alt_Del_Else_Print  &kp A  &kp R  &kp S                &kp T                  &kp D                             &kp LEFT  &kp ENTER  &kp RIGHT  &kp H        &kp N                 &kp E                    &kp I    &kp O          &kp SQT
&kp LCTRL            &kp Z  &kp X  &kp C                &kp V                  &kp B               &kp K_MUTE              &kp DOWN              &kp K        &kp M                 &kp COMMA                &kp DOT  &kp FSLH       &kp BACKSLASH
                                   &Sh_ShDel_Else_LAlt  &mt LEFT_SHIFT ESCAPE  &mt LGUI BACKSLASH                                                &lt 2 ENTER  &alt_menu_else_space  &ctrl_ralt_else_f5_navi
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_2 {
            display-name = "NumSym";
            bindings = <
&kp TAB              &kp LS(N1)  &kp LS(MINUS)  &kp LS(EQUAL)         &kp EQUAL              &none                                           &kp UP                &none        &none      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none     &kp BSPC
&Alt_Del_Else_Print  &kp N1      &kp N2         &kp N3                &kp N4                 &kp N5                                &kp LEFT  &kp ENTER  &kp RIGHT  &kp N6       &kp N7     &kp N8            &kp N9             &kp N0    &kp SQT
&kp LCTRL            &kp GRAVE   &kp LS(GRAVE)  &kp LS(LEFT_BRACKET)  &kp LS(RIGHT_BRACKET)  &kp LC(BACKSPACE)   &kp LG(K_MUTE)              &kp DOWN              &kp DELETE   &kp MINUS  &kp COMMA         &kp DOT            &kp FSLH  &kp BACKSLASH
                                                &Sh_ShDel_Else_LAlt   &mt LEFT_SHIFT ESCAPE  &mt LGUI BACKSLASH                                                    &lt 2 ENTER  &kp SPACE  &lt 3 F5
            >;

            sensor-bindings = <&inc_dec_kp LG(C_VOLUME_UP) LG(C_VOLUME_DOWN)>;
        };

        layer_3 {
            display-name = "Navi";
            bindings = <
&kp TAB           &kp Q           &kp W           &kp E         &kp R            &to 1                                       &mmv MOVE_UP                     &none        &kp LS(COMMA)   &kp PAGE_DOWN   &kp PAGE_UP   &kp LS(PERIOD)   &none
&kp LEFT_SHIFT    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &to 0                       &mmv MOVE_LEFT  &mkp MB3        &mmv MOVE_RIGHT  &kp C_PAUSE  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none
&kp LEFT_CONTROL  &kp Z           &kp X           &kp C         &kp V            &none     &kp LG(K_MUTE)                    &mmv MOVE_DOWN                   &none        &kp C_PREVIOUS  &kp END         &kp HOME      &kp C_NEXT       &none
                                                  &mkp MB3      &mkp MB1         &mkp MB2                                                                     &kp ENTER    &kp SPACE       &none
            >;

            sensor-bindings = <&inc_dec_kp LG(C_VOLUME_UP) LG(C_VOLUME_DOWN)>;
        };

        layer_4 {
            display-name = "Fn";
            bindings = <
&kp F1            &kp F2          &kp F3           &kp F4          &kp F5             &kp F6                                              &msc SCRL_UP                     &kp F7        &kp F8           &kp F9    &kp F10        &kp F11  &kp F12
&bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1     &bt BT_SEL 2    &bt BT_SEL 3       &bt BT_SEL 4                        &msc SCRL_LEFT  &kp ENTER       &msc SCRL_RIGHT  &out OUT_BLE  &kp PRINTSCREEN  &kp HOME  &kp PAGE_UP    &to 0    &to 3
&kp LEFT_CONTROL  &bt BT_CLR_ALL  &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &ext_power EP_OFF  &ext_power EP_ON  &kp LG(K_MUTE)                    &msc SCRL_DOWN                   &out OUT_USB  &kp C_PAUSE      &kp END   &kp PAGE_DOWN  &to 1    &none
                                                   &kp LEFT_ALT    &kp LEFT_SHIFT     &kp LEFT_META                                                                        &none         &kp SPACE        &none
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };
    };
};
