#define ZMK_MOUSE_DEFAULT_MOVE_VAL 800  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 50    // 10

#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <behaviors/num_word.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener {
    warp {
        layers = <0>;
        input-processors = <&zip_xy_scaler 3 1>;
        process-next;
    };

    precision {
        layers = <3>;
        input-processors = <&zip_xy_scaler 1 2>;
    };
};

/*
   &msc_input_listener {
       input-processors = <&zip_xy_scaler 2 1>;
   };

 */

/ {
    behaviors {
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <30>;
    };

    Navi_Paste_Copy: Navi_Paste_Copy {
        compatible = "zmk,behavior-tap-dance";
        label = "NAVI_PASTE_COPY";
        #binding-cells = <0>;
        bindings = <&lt 4 C_AC_PASTE>, <&kp C_AC_COPY>;

        tapping-term-ms = <200>;
    };

    Sh_Del_Else_NPC: Sh_Del_Else_NPC {
        compatible = "zmk,behavior-mod-morph";
        label = "SH_DEL_ELSE_NPC";
        bindings = <&Navi_Paste_Copy>, <&kp DELETE>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT)>;
    };

    Sh_ShDel_Else_LAlt: Sh_ShDel_Else_LAlt {
        compatible = "zmk,behavior-mod-morph";
        label = "SH_SHDEL_ELSE_LALT";
        bindings = <&mt LEFT_ALT MINUS>, <&kp LS(DELETE)>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT)>;
    };

    Esc_CWord: Esc_CWord {
        compatible = "zmk,behavior-tap-dance";
        label = "ESC_CWORD";
        #binding-cells = <0>;
        tapping-term-ms = <225>;
        bindings = <&kp ESCAPE>, <&caps_word>;
    };

    Ent_NWord: Ent_NWord {
        compatible = "zmk,behavior-tap-dance";
        label = "ENT_NWORD";
        #binding-cells = <0>;
        tapping-term-ms = <225>;
        bindings = <&kp ENTER>, <&num_word 2>;
    };

    kp_Esc_CWord: kp_Esc_CWord {
        compatible = "zmk,behavior-hold-tap";
        label = "KP_ESC_CWORD";
        bindings = <&kp>, <&Esc_CWord>;

        #binding-cells = <2>;
        tapping-term-ms = <225>;
        quick-tap-ms = <200>;
        flavor = "hold-preferred";
        hold-while-undecided;
    };

    mo_Ent_NWord: mo_Ent_NWord {
        compatible = "zmk,behavior-hold-tap";
        label = "MO_ENT_NWORD";
        bindings = <&mo>, <&Ent_NWord>;

        #binding-cells = <2>;
        tapping-term-ms = <225>;
        quick-tap-ms = <200>;
        flavor = "hold-preferred";
        hold-while-undecided;
    };

    kp_kp: kp_kp {
        compatible = "zmk,behavior-hold-tap";
        label = "KP_KP";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        hold-while-undecided;
        tapping-term-ms = <200>;
    };

    Tab_F1: Tab_F1 {
        compatible = "zmk,behavior-tap-dance";
        label = "TAB_F1";
        #binding-cells = <0>;
        tapping-term-ms = <225>;
        bindings = <&kp TAB>, <&kp F1>;
    };

    mo_Tab_F1: mo_Tab_F1 {
        compatible = "zmk,behavior-hold-tap";
        label = "MO_TAB_F1";
        bindings = <&mo>, <&Tab_F1>;

        #binding-cells = <2>;
        tapping-term-ms = <225>;
        quick-tap-ms = <200>;
        flavor = "hold-preferred";
        hold-while-undecided;
    };

    combos {
        compatible = "zmk,combos";

        Combo_Ctrl_Period {
            bindings = <&Sticky_Num>;
            key-positions = <28 39>;
            layers = <1>;
            timeout-ms = <200>;
        };
    };

    macros {
        Sticky_Num: wcpn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(PERIOD) &sl 2>;
            label = "WCPN";
            wait-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_5 {
            display-name = "Numpad";
            bindings = <
&none      &kp COMMA     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3           &kp LC(X)                          &kp UP                &none        &kp TAB        &kp LS(TAB)  &none   &none      &kp BACKSPACE
&kp LC(A)  &kp NUMBER_0  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6           &kp LC(C)                &kp LEFT  &kp ENTER  &kp RIGHT  &none        &kp LEFT       &kp DOWN     &kp UP  &kp RIGHT  &to 1
&none      &kp PERIOD    &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9           &kp LC(V)  &kp K_MUTE              &kp DOWN              &none        &kp BACKSPACE  &kp DELETE   &none   &none      &to 3
                                       &kp MINUS     &mt LEFT_SHIFT ESCAPE  &kp SPACE                                                &lt 2 ENTER  &lt 1 SPACE    &lt 3 EQUAL
            >;

            sensor-bindings = <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        layer_0 {
            display-name = "Colemak";
            bindings = <
&mo_Tab_F1 5 0            &kp Q  &kp W  &kp F                &kp P                       &kp G                                               &kp UP                &kp J              &kp L      &kp U      &kp Y    &kp SEMICOLON  &kp BSPC
&Sh_Del_Else_NPC          &kp A  &kp R  &kp S                &kp T                       &kp D                                     &kp LEFT  &kp ENTER  &kp RIGHT  &kp H              &kp N      &kp E      &kp I    &kp O          &kp SQT
&kp_kp LCTRL PRINTSCREEN  &kp Z  &kp X  &kp C                &kp V                       &kp B                       &kp K_MUTE              &kp DOWN              &kp K              &kp M      &kp COMMA  &kp DOT  &kp FSLH       &kp BACKSLASH
                                        &Sh_ShDel_Else_LAlt  &kp_Esc_CWord LEFT_SHIFT 0  &kp_kp LEFT_META BACKSLASH                                                &mo_Ent_NWord 2 0  &kp SPACE  &lt 5 F13
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_2 {
            display-name = "NumSym";
            bindings = <
&kp TAB                   &kp LS(N1)  &kp LS(MINUS)  &kp LS(EQUAL)         &kp EQUAL                   &none                                                   &kp UP                &none              &none      &none      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BSPC
&Sh_Del_Else_NPC          &kp N1      &kp N2         &kp N3                &kp N4                      &kp N5                                        &kp LEFT  &kp ENTER  &kp RIGHT  &kp N6             &kp N7     &kp N8     &kp N9            &kp N0             &kp SQT
&kp_kp LCTRL PRINTSCREEN  &kp GRAVE   &none          &kp LS(LEFT_BRACKET)  &kp LS(RIGHT_BRACKET)       &kp LC(BACKSPACE)           &kp LG(K_MUTE)              &kp DOWN              &kp DELETE         &kp MINUS  &kp COMMA  &kp DOT           &kp FSLH           &kp BACKSLASH
                                                     &Sh_ShDel_Else_LAlt   &kp_Esc_CWord LEFT_SHIFT 0  &kp_kp LEFT_META BACKSLASH                                                    &mo_Ent_NWord 2 0  &kp SPACE  &lt 5 F13
            >;

            sensor-bindings = <&inc_dec_kp LG(C_VOLUME_UP) LG(C_VOLUME_DOWN)>;
        };

        layer_1 {
            display-name = "QWERTY";
            bindings = <
&mo_Tab_F1 5 0            &kp Q  &kp W  &kp E                &kp R                       &kp T                                               &kp UP                &kp Y              &kp U      &kp I      &kp O    &kp P     &kp BSPC
&Sh_Del_Else_NPC          &kp A  &kp S  &kp D                &kp F                       &kp G                                     &kp LEFT  &kp ENTER  &kp RIGHT  &kp H              &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
&kp_kp LCTRL PRINTSCREEN  &kp Z  &kp X  &kp C                &kp V                       &kp B                       &kp K_MUTE              &kp DOWN              &kp N              &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp BACKSLASH
                                        &Sh_ShDel_Else_LAlt  &kp_Esc_CWord LEFT_SHIFT 0  &kp_kp LEFT_META BACKSLASH                                                &mo_Ent_NWord 2 0  &kp SPACE  &lt 5 F13
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_3 {
            display-name = "Navi";
            bindings = <
&to 1             &kp Q           &kp W           &kp F         &kp R            &none                                        &mmv MOVE_UP                     &none        &kp LS(COMMA)   &kp PAGE_DOWN  &kp PAGE_UP  &kp LS(PERIOD)  &none
&Navi_Paste_Copy  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none                        &mmv MOVE_LEFT  &mkp MB3        &mmv MOVE_RIGHT  &kp C_PAUSE  &kp LEFT        &kp DOWN       &kp UP       &kp RIGHT       &none
&to 3             &kp Z           &kp X           &kp C         &kp V            &none          &kp K_MUTE                    &mmv MOVE_DOWN                   &none        &kp C_PREVIOUS  &kp END        &kp HOME     &kp C_NEXT      &none
                                                  &mkp MB1      &mkp MB2         &kp LEFT_META                                                                 &kp ENTER    &kp SPACE       &mkp MB3
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_4 {
            display-name = "Fn";
            bindings = <
&kp F1                 &kp F2          &kp F3           &kp F4              &kp F5                      &kp F6                                          &msc SCRL_UP                     &kp F7        &kp F8           &kp F9    &kp F10        &kp F11  &kp F12
&bt BT_CLR             &bt BT_SEL 0    &bt BT_SEL 1     &bt BT_SEL 2        &bt BT_SEL 3                &bt BT_SEL 4                    &msc SCRL_LEFT  &kp ENTER       &msc SCRL_RIGHT  &out OUT_BLE  &kp PRINTSCREEN  &kp HOME  &kp PAGE_UP    &to 1    &to 4
&mt LCTRL PRINTSCREEN  &bt BT_CLR_ALL  &rgb_ug RGB_OFF  &rgb_ug RGB_ON      &ext_power EP_OFF           &ext_power EP_ON  &kp K_MUTE                    &msc SCRL_DOWN                   &out OUT_USB  &kp C_PAUSE      &kp END   &kp PAGE_DOWN  &to 3    &to 0
                                                        &mt LEFT_ALT MINUS  &kp_Esc_CWord LEFT_SHIFT 0  &kp LEFT_META                                                                    &none         &kp SPACE        &none
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };
    };
};
